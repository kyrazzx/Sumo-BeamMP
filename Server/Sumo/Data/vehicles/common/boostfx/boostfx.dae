  <library_effects>
    <effect id="mat_ab_heat_4a-effect">
      <profile_COMMON>
        <newparam sid="boostflame_side_dds-surface">
          <surface type="2D">
            <init_from>boostflame_side_dds</init_from>
          </surface>
        </newparam>
        <newparam sid="boostflame_side_dds-sampler">
          <sampler2D>
            <source>boostflame_side_dds-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="boostflame_side_dds-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
